# rag-service 环境变量样例。前缀 RAG_，嵌套分隔符 __。
# 口径见《rag-service-整体结构设计》§3.4 与《技术选型和实现方案》§2.4。

# ── LLM ──
RAG_LLM__PROVIDER=deepseek              # claude | qwen | deepseek | local
RAG_LLM__MODEL_NAME=deepseek-chat
RAG_LLM__API_KEY=changeme
RAG_LLM__BASE_URL=https://api.deepseek.com
RAG_LLM__PROMPT_VERSION=v1
RAG_LLM__TEMPERATURE=0.2
RAG_LLM__TIMEOUT=30

# ── Embedding（bge 本地化推理 sidecar）──
RAG_EMBEDDING__BASE_URL=http://bge-inference:8080
RAG_EMBEDDING__MODEL=bge-m3
RAG_EMBEDDING__DIM=1024
RAG_EMBEDDING__RERANKER_MODEL=bge-reranker-v2-m3
RAG_EMBEDDING__BATCH_SIZE=32

# ── Neo4j（A）──
RAG_NEO4J__URI=bolt://neo4j:7687
RAG_NEO4J__USERNAME=neo4j
RAG_NEO4J__PASSWORD=rag
RAG_NEO4J__MAX_CONNECTIONS=50

# ── ChromaDB（B，嵌入式）──
RAG_CHROMA__PERSIST_DIR=/data/chroma
RAG_CHROMA__COLLECTION=document_chunks

# ── MySQL（shared/A/E + B 幂等位点审计）──
RAG_MYSQL__DSN=mysql+asyncmy://rag:rag@mysql:3306/rag
RAG_MYSQL__POOL_SIZE=10
RAG_MYSQL__MAX_OVERFLOW=20

# ── Redis ──
RAG_REDIS__URL=redis://redis:6379/0

# ── Kafka ──
RAG_KAFKA__BOOTSTRAP=kafka:9092
RAG_KAFKA__CONSUMER_GROUP_PREFIX=rag

# ── MinIO（B 原始文档）──
RAG_MINIO__ENDPOINT=minio:9000
RAG_MINIO__ACCESS_KEY=minioadmin
RAG_MINIO__SECRET_KEY=minioadmin
RAG_MINIO__BUCKET=rag-docs
RAG_MINIO__SECURE=false

# ── OTel ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=rag-service

# ── agent-service（E 委托 L1/L2）──
RAG_AGENT__L1_BASE_URL=http://agent-service:8001
RAG_AGENT__L2_BASE_URL=http://agent-service:8001
RAG_AGENT__L1_TIMEOUT=60
RAG_AGENT__L2_TIMEOUT=30

# ── 路线级开关（灰度引入：先 B 再 A，E 收口）──
RAG_DOCUMENT__ENABLED=true
RAG_TRACEABILITY__ENABLED=false
RAG_AGENTIC__ENABLED=false

# ── 路线子配置 ──
RAG_DOCUMENT__RETRIEVAL_TOP_K=20
RAG_DOCUMENT__RERANK_TOP_N=5
RAG_DOCUMENT__CACHE_TTL_SECONDS=300
RAG_AGENTIC__CACHE_TTL_SECONDS=300
RAG_TRACEABILITY__SUBGRAPH_CACHE_TTL_SECONDS=60
