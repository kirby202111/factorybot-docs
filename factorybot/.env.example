# ===== LLM =====
# 留空则用 MockChatModel（确定性，离线可跑）；填则切真实 provider
# 可选：mock | openai | deepseek | anthropic | dashscope
LLM_PROVIDER=              # 例：deepseek
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=

# DeepSeek 示例（兼容 OpenAI 协议，复用 langchain-openai，无需额外依赖）：
# deepseek-v4-flash 为 DeepSeek 最新模型（非 deepseek-chat）
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-你的DeepSeek密钥
# LLM_MODEL=deepseek-v4-flash      # DeepSeek 最新模型
# LLM_BASE_URL=https://api.deepseek.com
# RUN_MODE=real

# ===== 运行模式 =====
# mock=全离线（默认）；real=用下面真实连接
RUN_MODE=mock

# ===== MySQL（SqlSaver checkpoint + 业务可观测表）=====
# 留空则用 MemorySaver + 进程内仓库
MYSQL_URL=

# ===== Redis（ConfirmationStore / ToolResultCache / 限流）=====
# 留空则用进程内 FakeRedis
REDIS_URL=

# ===== Kafka（动作卡持久推送 + 领域事件订阅）=====
# 留空则用 MockActionCardProducer（仅日志）
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_GROUP_ID=agent-service

# ===== OTel =====
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-service

# ===== 业务默认值（mock 场景的示例租户）=====
DEFAULT_TENANT_ID=WS-A
DEFAULT_WORKSHOP=SMT-1
DEFAULT_LINE=L-01

# ===== 租户权限（real 模式 scopes；对应待办 #34）=====
# 留空则用 config.py 保守默认（WS-A 全权 / WS-B 只读 / 其它 fail-closed）。
# 生产按真实车间 ID 覆盖，JSON 格式；可用 scope 见 app/config.py 注释。
# 写 scope：rework:write / process:write / pass:write（给哪个车间取决于它是否承担该操作）。
# TENANT_SCOPES={"WS-A":["pass:read","workorder:read","rework:write","process:write","pass:write"],"WS-B":["pass:read","workorder:read"]}
